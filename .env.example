NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/salon?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379
# Optional HTTPS adapters; see docs/providers.md. Unconfigured providers fail closed.
PAYMENT_PROVIDER_URL=
PAYMENT_PROVIDER_TOKEN=
MESSAGE_PROVIDER_URL=
MESSAGE_PROVIDER_TOKEN=
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=replace-with-a-strong-password
